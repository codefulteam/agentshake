{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:84258535-c575-4913-8e1c-420a939a31d5",
  "title": "Agentshake capabilities 1",
  "description": "Output of `agentshake capabilities --json`. Static and local; grants nothing. New fields may be added; readers ignore unknown ones.",
  "type": "object",
  "required": [
    "format",
    "software",
    "protocols",
    "proposals",
    "profiles",
    "operations",
    "localExchange",
    "limits",
    "schemas"
  ],
  "properties": {
    "format": {
      "const": "agentshake-capabilities/1"
    },
    "software": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "agentshake"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "status",
          "spec"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "status": {
            "const": "supported"
          },
          "spec": {
            "type": "string"
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "status",
          "spec"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "status": {
            "const": "proposal-not-implemented"
          },
          "spec": {
            "type": "string"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "channelPrefix",
          "authenticated",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "channelPrefix": {
            "type": "string"
          },
          "authenticated": {
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "remote-repository",
              "single-trusted-machine"
            ]
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "offer",
          "ask",
          "supply",
          "confirm",
          "accept",
          "decline",
          "cancel",
          "reply",
          "complete"
        ]
      }
    },
    "localExchange": {
      "type": "object",
      "required": [
        "format",
        "draftActions",
        "briefStages",
        "approval"
      ],
      "properties": {
        "format": {
          "const": "local-exchange/1"
        },
        "draftActions": {
          "type": "array",
          "items": {
            "enum": [
              "new",
              "reply",
              "ask",
              "supply",
              "confirm"
            ]
          }
        },
        "briefStages": {
          "type": "array",
          "items": {
            "enum": [
              "negotiating",
              "accepted",
              "finished"
            ]
          }
        },
        "approval": {
          "const": "operator-approval-per-signed-event"
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "ledgerBytes",
        "requests",
        "events",
        "eventsPerRequest",
        "itemsPerRound",
        "suppliesPerRequest",
        "titleCharacters",
        "bodyBytes",
        "needBytes",
        "understandingBytes",
        "ttlHours"
      ],
      "additionalProperties": false,
      "properties": {
        "ledgerBytes": {
          "type": "integer"
        },
        "requests": {
          "type": "integer"
        },
        "events": {
          "type": "integer"
        },
        "eventsPerRequest": {
          "type": "integer"
        },
        "itemsPerRound": {
          "type": "integer"
        },
        "suppliesPerRequest": {
          "type": "integer"
        },
        "titleCharacters": {
          "type": "integer"
        },
        "bodyBytes": {
          "type": "integer"
        },
        "needBytes": {
          "type": "integer"
        },
        "understandingBytes": {
          "type": "integer"
        },
        "ttlHours": {
          "type": "object",
          "required": [
            "min",
            "max",
            "default"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "default": {
              "type": "integer"
            }
          }
        }
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
