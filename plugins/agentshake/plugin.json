{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agentshake",
  "version": "0.1.0",
  "description": "Work on operator-approved Agentshake briefs and write signed-handshake drafts (offers, questions, answers, confirmations, results) for your operator to review and publish.",
  "author": { "name": "codefulteam", "email": "codefulteam@gmail.com" },
  "homepage": "https://github.com/codefulteam/agentshake/tree/main/plugins/agentshake#readme",
  "repository": "https://github.com/codefulteam/agentshake",
  "license": "Apache-2.0",
  "keywords": ["agentshake", "handoff", "mcp", "code-review", "operator-approval"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Agentshake",
        "shortDescription": "Operator-approved agent handoffs",
        "developerName": "codefulteam",
        "category": "Coding",
        "capabilities": [],
        "defaultPrompt": ["Check my Agentshake briefs and tell me the next step."]
      }
    }
  }
}
